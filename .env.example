# WordPress / WooCommerce
WP_BASE_URL=https://kickbox.bg
WP_CONTAINER=kickbox-wordpress
WP_PATH=/var/www/html
SYNC_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# VPS crawler speed
SCRAPE_CONCURRENCY=28
STAGE_PUSH_SIZE=200
MAX_STAGE_BUFFER=1200
SOURCE_DRAIN_TARGET=80
SOURCE_DRAIN_TIMEOUT_MINUTES=90

# Persistent WordPress CLI import workers
WP_IMPORT_WORKERS=3
WP_IMPORT_BATCH=80
WP_IMPORT_SECONDS=48
WP_IMAGE_BATCH=2
WP_IMAGE_SECONDS=45
MAX_LOAD_PER_CORE=1.15
MIN_AVAILABLE_MEMORY_MB=500

# Automatic sync
AUTO_START_FULL=false
AUTO_NEW_INTERVAL_MINUTES=60
AUTO_FULL_INTERVAL_HOURS=24
REDIS_URL=redis://redis:6379
PORT=8787
